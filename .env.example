# Discord-Bot-Token aus dem Developer Portal (Bot → Reset Token).
DISCORD_TOKEN=

# Optional: ID deines Servers. Wenn gesetzt, werden die Slash-Commands sofort
# auf diesem Server registriert (statt global, was bis zu ~1 Stunde dauert).
# Praktisch zum Testen. Discord → Server → Servereinstellungen → Erweitert →
# Entwicklermodus aktivieren, dann Rechtsklick auf den Server → "ID kopieren".
# GUILD_ID=

# Auf 1 setzen, um die Sammelkarten-Rewards fürs Spielen zu aktivieren.
# ERFORDERT, dass im Developer Portal (Bot → Privileged Gateway Intents) sowohl
# "Presence Intent" als auch "Server Members Intent" aktiviert sind — sonst
# startet der Bot nicht. Ohne diese Variable bleibt das Feature inaktiv.
# PRESENCE_INTENT=1

# --- Twitch Live-Benachrichtigungen (optional) ------------------------------
# Im Twitch Developer Console eine App anlegen und hier die Client-Credentials
# hinterlegen. Sie werden nur serverseitig für die Twitch-Helix-Abfrage genutzt.
# Anschließend im WebPanel unter „Twitch Live“ Twitch-Kanal und Discord-Channel
# wählen. Live-Benachrichtigungen benötigen keine Twitch-User-Tokens.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# --- Twitch-Chatbot unter /twitch (optional, zusätzlich zu Twitch Live) -------
# Gleiche vertrauliche Twitch-App wie oben. Redirect in der Developer Console:
# https://yamikun.eu/twitch/callback (muss zu WEB_BASE_URL passen).
# WEB_ENABLED=1 und eine öffentliche HTTPS-URL sind erforderlich.
# TWITCH_CHAT_ENABLED=1
# Numerische Twitch-ID des separaten Botkontos (nicht deine Discord-ID).
# TWITCH_BOT_USER_ID=
# Zufälliges Geheimnis, 32–100 ASCII-Zeichen, für signierte EventSub-Webhooks.
# Erzeugen: python -c 'import secrets; print(secrets.token_hex(32))'
# TWITCH_EVENTSUB_SECRET=
# Dauerhaften Fernet-Schlüssel erzeugen (nach Installation der requirements):
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# TWITCH_TOKEN_KEY=
# Schlüssel sichern und über Deployments hinweg beibehalten. Die Datenbank
# speichert damit verschlüsselte Twitch-Access-/Refresh-Tokens.
# Einmal als Botkonto anmelden: https://yamikun.eu/twitch?setup=bot
# Danach können Streamer ihren eigenen Channel unter /twitch hinzufügen.
# Details, Commands und Kontoverknüpfung: docs/twitch-chat.md

# Optional: Eigener identifizierender User-Agent für nekos.best-GIFs.
# Format laut API: APP_NAME (KONTAKT_URL_ODER_E-MAIL)
# Standard: YamiKun (https://yamikun.eu)
# NEKOS_USER_AGENT=YamiKun (https://yamikun.eu)

# --- Web-Adminpanel (optional) -----------------------------------------------
# Auf 1 setzen, um das Web-Panel (Karten/Spiele/Channel verwalten) zu starten.
# WEB_ENABLED=1
#
# Öffentlich erreichbare Basis-URL des Panels (ohne abschließenden /). Wird für
# die OAuth-Redirect-URL UND die Karten-Bild-URLs verwendet, daher MUSS sie von
# Discord erreichbar sein (z.B. via Cloudflare Tunnel / Tailscale Funnel).
# WEB_BASE_URL=https://yamikun.eu
#
# Aus dem Discord Developer Portal → deine App → OAuth2:
#   Client ID     = "OAuth2 → Client ID"
#   Client Secret = "OAuth2 → Reset Secret"
# Trage zusätzlich im Portal unter OAuth2 → Redirects ein:  <WEB_BASE_URL>/callback
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
#
# Optional: Bind-Adresse/Port des lokalen Servers (Standard 0.0.0.0:8080).
# WEB_HOST=0.0.0.0
# WEB_PORT=8080

# Optional: Nur diese Discord-User-IDs dürfen im Panel Karten hoch-/runterladen
# (Sammel- & Yami-Karten). Komma-getrennt. Leer/weggelassen = alle Server-Admins
# dürfen es (wie bisher). Ansehen darf weiterhin jeder Admin.
# Globale Guthabenänderungen und Inventarlöschungen benötigen immer einen Eintrag.
# Ohne Owner sind diese beiden Aktionen gesperrt.
# WEB_OWNER_IDS=123456789012345678,234567890123456789
#
# Optional: Optimierung hochgeladener Kartenbilder für schnelles Laden in Discord.
# Alle Karten werden als WebP gespeichert; alte lokale Bilder werden beim Start
# automatisch migriert. Die Standardwerte sind für Discord bereits konservativ.
# CARD_IMAGE_WEBP_QUALITY=82
# CARD_IMAGE_MAX_DIMENSION=1200
# CARD_IMAGE_ANIMATED_MAX_DIMENSION=960
# CARD_IMAGE_MAX_FRAMES=80
# CARD_IMAGE_MAX_BYTES=6291456
