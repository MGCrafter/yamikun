# Discord-Bot-Token aus dem Developer Portal (Bot → Reset Token).
DISCORD_TOKEN=

# Optional: ID deines Servers. Wenn gesetzt, werden die Slash-Commands sofort
# auf diesem Server registriert (statt global, was bis zu ~1 Stunde dauert).
# Praktisch zum Testen. Discord → Server → Servereinstellungen → Erweitert →
# Entwicklermodus aktivieren, dann Rechtsklick auf den Server → "ID kopieren".
# GUILD_ID=

# Auf 1 setzen, um die Sammelkarten-Rewards fürs Spielen zu aktivieren.
# ERFORDERT, dass im Developer Portal (Bot → Privileged Gateway Intents) sowohl
# "Presence Intent" als auch "Server Members Intent" aktiviert sind — sonst
# startet der Bot nicht. Ohne diese Variable bleibt das Feature inaktiv.
# PRESENCE_INTENT=1

# --- Web-Adminpanel (optional) -----------------------------------------------
# Auf 1 setzen, um das Web-Panel (Karten/Spiele/Channel verwalten) zu starten.
# WEB_ENABLED=1
#
# Öffentlich erreichbare Basis-URL des Panels (ohne abschließenden /). Wird für
# die OAuth-Redirect-URL UND die Karten-Bild-URLs verwendet, daher MUSS sie von
# Discord erreichbar sein (z.B. via Cloudflare Tunnel / Tailscale Funnel).
# WEB_BASE_URL=https://panel.deine-domain.de
#
# Aus dem Discord Developer Portal → deine App → OAuth2:
#   Client ID     = "OAuth2 → Client ID"
#   Client Secret = "OAuth2 → Reset Secret"
# Trage zusätzlich im Portal unter OAuth2 → Redirects ein:  <WEB_BASE_URL>/callback
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
#
# Optional: Bind-Adresse/Port des lokalen Servers (Standard 0.0.0.0:8080).
# WEB_HOST=0.0.0.0
# WEB_PORT=8080
